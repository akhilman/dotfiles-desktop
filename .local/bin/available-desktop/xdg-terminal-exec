#!/bin/sh

TERM=xterm
PROGARG=-e

case "$XDG_SESSION_DESKTOP" in
	sway )
		TERM=foot
		PROGARG=
		;;
	gnome )
		if command -v kgx > /dev/null 2>&1; then
			TERM=kgx
		else
			TERM=gnome-terminal
		fi
		;;
	xfce )
		TERM="exo-open --launch TerminalEmulator"
		PROGARG=
		;;
	* )
		if command -v kitty > /dev/null 2>&1; then
			TERM=kitty
			PROGARG=
		elif command -v ghostty > /dev/null 2>&1; then
			TERM=ghostty
		elif command -v alacritty > /dev/null 2>&1; then
			TERM=alacritty
		fi
		;;
esac

if [ $# -gt 0 ]; then
	$TERM $PROGARG $@
else
	$TERM
fi
